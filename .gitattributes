# Auto detect text files, normalize to LF in repo AND on checkout (cross-platform consistency)
* text=auto eol=lf

# Platform-native scripts must stay CRLF
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Binary files
*.woff          binary
*.woff2         binary
*.ttf           binary
*.otf           binary
*.eot           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary

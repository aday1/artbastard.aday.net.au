# ArtBastard Environment Configuration
# 
# Copy this file to `.env` and adjust values for your setup.
# Most options are optional—defaults work for localhost development.
#
# This file is used by:
# - docker-compose.yml (production)
# - npm scripts (local development)

# === Server ===
PORT=3030
NODE_ENV=production

# === DMX Output (Optional) ===
# Only set these if you have local DMX hardware connected.
# Leave blank for no local DMX output (Art-Net / OSC mode only).

# USB serial port for DMX (Linux/macOS)
# Linux example:   /dev/ttyUSB0, /dev/ttyACM0
# macOS example:   /dev/tty.usbserial-FT5RY3L, /dev/cu.wchusbserial1410
# Windows example: COM3, COM4
# DMX_INTERFACE=

# === Art-Net (Optional) ===
# Send DMX via Art-Net UDP to a node/receiver on your network.
# ARTNET_HOST=192.168.1.100
# ARTNET_PORT=6454

# === Cloud + LAN Bridge (Optional) ===
# When using the hosted app (artbastard.aday.net.au) with local LAN fixtures,
# deploy a Raspberry Pi bridge agent to forward Art-Net / Ableton Link.
# See DOCS/BRIDGE.md for setup.
# BRIDGE_URL=http://192.168.1.50:9000

# === Development (not normally needed) ===
# DEBUG=artbastard:*           # Enable debug logging (all modules)
# DEBUG=artbastard:backend:*   # Backend only
# VITE_API_BASE=http://localhost:3030  # API base URL for frontend

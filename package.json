{
  "name": "artbastard-dmx512",
  "version": "5.2.3.3",
  "description": "ArtBastard DMX512 Controller - Photonic Supremacy Edition. Élite Illumination Control for the Discerning Luminaire Artist.",
  "main": "dist/server.js",
  "bin": {
    "artbastard": "./dist/server.js"
  },
  "keywords": [
    "dmx",
    "dmx512",
    "lighting",
    "artnet",
    "theater",
    "stage",
    "lighting-control",
    "midi",
    "osc",
    "photonic",
    "lighting-design",
    "theatrical-lighting"
  ],
  "author": "Le Créateur des Lumières",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aday1/artbastard.aday.net.au.git"
  },
  "homepage": "https://artbastard.aday.net.au/",
  "bugs": {
    "url": "https://github.com/aday1/artbastard.aday.net.au/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "react-app/dist",
    "package.json",
    "README.md",
    "LICENSE",
    "start.sh",
    "start.ps1",
    "DOCS"
  ],
  "scripts": {
    "build": "npm run build-backend && npm run build-frontend",
    "build-backend": "node build-backend.js",
    "build-backend-fast": "node build-backend-fast.js",
    "build-frontend": "cd react-app && npm run build",
    "build-frontend:skip-ts": "cd react-app && ./node_modules/.bin/vite build",
    "build-fast": "npm run build-backend-fast",
    "start": "npm run build-backend && node dist/server.js",
    "dev": "powershell -ExecutionPolicy Bypass -File start.ps1",
    "local:backend": "npm run build-backend-fast && node dist/server.js",
    "local:frontend": "npm --prefix react-app run dev",
    "local": "concurrently -n backend,ui -c blue,green \"npm run local:backend\" \"npm run local:frontend\"",
    "local:prod": "npm run build && node dist/server.js",
    "dev:backend": "nodemon src/main.ts",
    "dev:frontend": "cd react-app && npm run dev",
    "copy-static": "copyfiles -u 1 src/public/**/* dist",
    "watch": "npx tsc -w",
    "test": "cd react-app && npm test",
    "test:api-contract": "npm run build-backend-fast && node scripts/api-contract-smoke.js",
    "test:bridge-smoke": "npm run build-backend-fast && node scripts/bridge-smoke.js",
    "build:bridge": "cd bridge-agent && npm ci && npm run build",
    "demo:capture-screenshots": "bash scripts/capture-demo-screenshots.sh",
    "demo:capture-videos": "bash scripts/capture-demo-videos.sh",
    "demo:evidence": "npm run test:api-contract && npm run demo:capture-screenshots",
    "demo:evidence-full": "npm run demo:evidence && npm run demo:capture-videos",
    "test:coverage": "cd react-app && npm run test:coverage"
  },
  "dependencies": {
    "@julusian/midi": "^3.6.1",
    "boxen": "^5.1.2",
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dmxnet": "^0.9.0",
    "easymidi": "^3.1.0",
    "express": "^4.21.0",
    "osc": "^2.4.3",
    "ping": "^0.4.4",
    "socket.io": "^4.8.0"
  },
  "optionalDependencies": {
    "abletonlink": "^0.2.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^18.19.111",
    "@types/ping": "^0.4.4",
    "concurrently": "^8.2.2",
    "copyfiles": "^2.4.1",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^4.9.5"
  }
}
